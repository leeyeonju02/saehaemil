# 로컬 개발(.env.local)과 Vercel 등 배포 환경에 아래 값을 동일하게 넣으면 같은 Supabase DB를 사용합니다.
# 이 파일을 복사: cp .env.example .env.local

# Supabase 프로젝트 URL (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# anon / publishable public key (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 또는 새 키 이름:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# 서버 전용 — 공지 API·스토리지 업로드 등 (Dashboard → Settings → API → service_role, 비공개)
SUPABASE_SERVICE_ROLE_KEY=

# Storage 버킷 이름 (미설정 시 saehaemilImage)
# SUPABASE_STORAGE_BUCKET=saehaemilImage
